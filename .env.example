# Server & Core App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=
COOKIE_SECURE=false

# Initial Super Admin Bootstrap (optional)
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
INITIAL_SUPER_ADMIN_NAME=NOVARA Super Admin

# Media & Transactional Email
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=NOVARA COMMERCE <no-reply@novara.com.bd>

# Social OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Payment Gateway 1: SSLCommerz (Visa / Mastercard / Card Checkout & Multi-Channel Gateway)
PAYMENT_PROVIDER=sslcommerz
PAYMENT_SANDBOX=true
PAYMENT_STORE_ID=
PAYMENT_STORE_PASSWORD=
PAYMENT_WEBHOOK_SECRET=

# Payment Gateway 2: bKash Tokenized Checkout API
BKASH_SANDBOX=true
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Payment Gateway 3: Nagad Merchant Payment Gateway API
NAGAD_SANDBOX=true
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# Payment Session Timeout (Minutes)
PAYMENT_TIMEOUT_MINUTES=30
